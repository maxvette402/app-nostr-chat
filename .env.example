# Web app port (served by nginx inside Docker)
WEB_PORT=3000

# Comma-separated default relay URLs
DEFAULT_RELAYS=wss://relay.damus.io,wss://relay.nostr.band,wss://nos.lol

# Blossom file storage server URL
BLOSSOM_SERVER_URL=http://localhost:3001

# Public URL the Blossom server advertises in upload responses — set this to
# your real domain when deploying, otherwise download links will point at
# localhost.
BLOSSOM_PUBLIC_URL=http://localhost:3001

# Max accepted upload size in bytes (default 25 MiB)
BLOSSOM_MAX_UPLOAD_BYTES=26214400

# Comma-separated hex pubkeys allowed to upload/delete blobs. Leave empty to
# allow any validly signed Nostr auth event (still requires a real keypair,
# just not a specific one).
BLOSSOM_ALLOWED_PUBKEYS=

# Persistent volume path for Nostr relay and file storage (on host machine).
# Used for strfry event DB and Blossom file uploads.
# Default expands to ~/opt/docker/volumes-nostr (change if you need a different location).
VOLUMES_PATH=~/opt/docker/volumes-nostr

# Self-hosted strfry relay port (optional)
STRFRY_PORT=7777

# Node environment
NODE_ENV=production

# Vite build-time env vars (prefix with VITE_ to expose to browser)
VITE_DEFAULT_RELAYS=wss://relay.damus.io,wss://relay.nostr.band,wss://nos.lol
VITE_BLOSSOM_SERVER_URL=http://localhost:3001
